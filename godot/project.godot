; GaBi 2D — editable with the standard Godot editor, no plugins required.
config_version=5

[application]
config/name="GaBi bei Dirk"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1400
window/size/viewport_height=930
window/size/window_width_override=1400
window/size/window_height_override=930
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.91, 0.87, 0.75, 1)
